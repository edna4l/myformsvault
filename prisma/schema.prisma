// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["myformsvault"]
}

enum FormStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("myformsvault")
}

enum TemplateCategory {
  LEAD_INTAKE
  EDUCATION
  MEDICAL
  FAMILY_CARE
  GENERAL

  @@schema("myformsvault")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  teamSize  String?
  message   String
  createdAt DateTime @default(now())

  @@schema("myformsvault")
}

model FormTemplate {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  category    TemplateCategory
  overview    String
  description String
  accent      String           @default("#ff7a00")
  sections    Json
  featured    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  forms       Form[]

  @@schema("myformsvault")
}

model FamilyMember {
  id            String          @id @default(cuid())
  householdName String
  fullName      String
  relationship  String?
  basicInfo     Json
  schoolInfo    Json?
  medicalInfo   Json?
  insuranceInfo Json?
  emergencyInfo Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  answerHistory AnswerHistory[]

  @@schema("myformsvault")
}

model Profile {
  id            String         @id @default(cuid())
  userId        String         @unique
  email         String         @unique
  fullName      String?
  isAdmin       Boolean        @default(false) @map("is_admin")
  plan          String         @default("free")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([isAdmin])
  @@schema("myformsvault")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  isAdmin   Boolean  @default(true) @map("is_admin")
  createdAt DateTime @default(now())

  @@map("admins")
  @@schema("myformsvault")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  profileId        String?
  status           String    @default("trialing")
  plan             String    @default("free")
  amountCents      Int       @default(0)
  interval         String    @default("month")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  profile          Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@schema("myformsvault")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  metadata   Json
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@schema("myformsvault")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyPrefix])
  @@schema("myformsvault")
}

model AnswerHistory {
  id             String       @id @default(cuid())
  familyMemberId String
  fieldKey       String
  fieldLabel     String
  value          String
  templateName   String
  formName       String
  createdAt      DateTime     @default(now())
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([familyMemberId, fieldKey, createdAt(sort: Desc)])
  @@schema("myformsvault")
}

model OriginalFormLayout {
  id             String   @id @default(cuid())
  name           String
  sourceFileName String
  sourceKind     String
  fieldMappings  Json
  placements     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt(sort: Desc)])
  @@schema("myformsvault")
}

model Form {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  headline    String
  description String
  accent      String           @default("#ff7a00")
  status      FormStatus       @default(DRAFT)
  fields      Json
  sections    Json?
  templateId  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
  template    FormTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@schema("myformsvault")
}

model FormSubmission {
  id             String   @id @default(cuid())
  formId         String
  fullName       String?
  email          String?
  company        String?
  website        String?
  goals          String?
  submitterName  String?
  submitterEmail String?
  summary        String?
  responses      Json?
  createdAt      DateTime @default(now())
  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt(sort: Desc)])
  @@schema("myformsvault")
}
